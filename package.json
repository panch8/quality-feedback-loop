{
  "name": "@panch8/quality-feedback-loop",
  "version": "0.1.0",
  "description": "Shareable quality enforcement configs for TypeScript/React/Node projects",
  "license": "MIT",
  "main": "prettier/index.js",
  "bin": {
    "q-feedback-init": "./scripts/init.js"
  },
  "files": [
    "eslint/",
    "prettier/",
    "tsconfig/",
    "lint-staged/",
    "scripts/"
  ],
  "exports": {
    "./eslint/base": "./eslint/base.js",
    "./eslint/react": "./eslint/react.js",
    "./eslint/node": "./eslint/node.js",
    "./prettier": "./prettier/index.js",
    "./tsconfig/base": "./tsconfig/base.json",
    "./tsconfig/app": "./tsconfig/app.json",
    "./tsconfig/node": "./tsconfig/node.json",
    "./lint-staged/frontend": "./lint-staged/frontend.js",
    "./lint-staged/backend": "./lint-staged/backend.js"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "peerDependencies": {
    "@eslint/js": ">=9",
    "eslint": ">=9",
    "eslint-config-prettier": ">=10",
    "eslint-plugin-react-hooks": ">=5",
    "eslint-plugin-react-refresh": ">=0.4",
    "globals": ">=16",
    "husky": ">=9",
    "prettier": ">=3",
    "typescript-eslint": ">=8"
  },
  "peerDependenciesMeta": {
    "husky": { "optional": true },
    "eslint-plugin-react-hooks": { "optional": true },
    "eslint-plugin-react-refresh": { "optional": true }
  }
}
